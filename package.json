{
  "name": "mesa-partes-presencial-ui",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4204  --disable-host-check=true",
    "start:desa": "ng serve --port 4204  --configuration desa",
    "start:test": "ng serve --port 4204  --configuration test",
    "start:prod": "ng serve --port 4204 --configuration production",
    "build:desa": "ng build --configuration desa",
    "build:test": "ng build --configuration test",
    "build:prod": "ng build --configuration production",
    "build:azure": "ng build --configuration azure",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --include '**/default.component.spec.ts' --watch=false --code-coverage --source-map=false",
    "api:mpp": "ng-openapi-gen -i ng-openapi/mesa-de-partes-presencial.json -o src/app/api/mesa-departes-presencial/ --services true --serviceIndex true --module true --promises false",
    "api:ga": "ng-openapi-gen -i ng-openapi/gestiones-administrativas.json -o src/app/api/gestiones-administrativas/ --services true --serviceIndex true --module true --promises false",
    "sonar": "sonar-scanner"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/common": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "@ng-bootstrap/ng-bootstrap": "^17.0.1",
    "@ng-select/ng-select": "^13.9.1",
    "@popperjs/core": "^2.11.8",
    "@types/crypto-js": "^4.2.2",
    "@types/html2canvas": "^1.0.0",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.0",
    "crypto-js": "^4.2.0",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "install": "^0.13.0",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "jwt-decode": "^4.0.0",
    "karma-sonarqube-reporter": "^1.4.0",
    "moment": "^2.30.1",
    "ng-openapi-gen": "^1.0.4",
    "rxjs": "~7.8.2",
    "sweetalert2": "^11.26.18",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.20",
    "@angular/cli": "^18.2.20",
    "@angular/compiler-cli": "^18.2.13",
    "@angular/localize": "^18.2.13",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.8",
    "jasmine-core": "~5.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sonar-scanner": "^3.1.0",
    "typescript": "~5.5.4"
  },
  "engines": {
    "node": ">=20"
  }

}
